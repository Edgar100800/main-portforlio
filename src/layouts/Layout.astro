---
import '@/styles/global.css';

export interface Props {
	title?: string;
	description?: string;
	lang?: string;
}

const { title = "Edgar Chambilla | Portfolio", description = "AI & creative developer who uses AI to build apps, games and videos", lang = "es" } = Astro.props;

// Detect language from URL
const currentPath = Astro.url.pathname;
const detectedLang = currentPath.startsWith('/en') ? 'en' : 'es';
const htmlLang = lang || detectedLang;
---
<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- ?v= forces browsers to drop the cached Astro favicon; bump it when the icons change. -->
		<link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png?v=2" sizes="96x96" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
		<link rel="manifest" href="/site.webmanifest?v=2" />
		<meta name="theme-color" content="#1c165b" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		
		<!-- Language alternates -->
		<link rel="alternate" hreflang="es" href={currentPath.replace('/en', '') || '/'} />
		<link rel="alternate" hreflang="en" href={currentPath.startsWith('/en') ? currentPath : '/en' + currentPath} />
		<link rel="alternate" hreflang="x-default" href={currentPath.replace('/en', '') || '/'} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
