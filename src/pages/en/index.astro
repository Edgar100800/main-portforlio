---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header';
import I18nProvider from '@/components/I18nProvider';
import MainContent from '@/components/MainContent';
import AnimatedGradientBackground from '@/components/AnimatedGradientBackground';
---

<Layout title="Edgar Chambilla | Portfolio">
	<I18nProvider client:load>
		<Header client:load basePath="/en" />
		<main class="relative min-h-screen overflow-hidden bg-[#3730a3] pt-20">
			<AnimatedGradientBackground client:load />
			<div class="relative z-10">
				<MainContent client:load />
			</div>
		</main>
	</I18nProvider>
</Layout>
